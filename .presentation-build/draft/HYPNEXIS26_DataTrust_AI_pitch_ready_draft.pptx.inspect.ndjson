{"kind":"textbox","id":"sh/l4bupwny","slideIndex":4,"position":{"left":76.8,"top":249.6,"width":326.4,"height":364.8},"name":"Technical Feasibility body","text":"Python, FastAPI, and SQLite run locally.\nA document mutation replaces only that document's index and graph records.\nBatch ingestion accepts up to 2,000 documents per request.\nResults report time, failures, ignored instructions, and graph size.\nSeeded SQLite datasets support repeatable local runs.\nThe deterministic test flow needs no paid model API key.","geometry":"rect","style":{"fontSize":18.67,"typeface":"Calibri","color":"#FFFFFF","alignment":"left"}}
{"kind":"shape","id":"sh/032tgr6d","slideIndex":4,"position":{"left":448.32,"top":177.6,"width":384,"height":465.6},"name":"Economic Feasibility card","geometry":"roundRect","fillColor":"rgba(11,26,74,0.75)","lineColor":"#1E5BFF","lineWidth":1.33}
