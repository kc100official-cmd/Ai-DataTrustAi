{"kind":"textbox","id":"sh/obq90bml","slideIndex":2,"position":{"left":76.8,"top":240,"width":518.4,"height":384},"name":"Arch body","text":"FastAPI accepts single documents and batches.\nSafety filters remove instruction-bearing text before indexing.\nSQLite stores documents, term postings, claims, entities, and edges.\nCreate, edit, and delete operations update only the affected document.\nHindi and romanized-Hindi terms expand toward English evidence.\nConflict checks keep each claim linked to its source excerpt.\nAnswers carry a verification status and graph evidence path.","geometry":"rect","style":{"fontSize":18.67,"typeface":"Calibri","color":"#FFFFFF","alignment":"left"}}
{"kind":"shape","id":"sh/pcjqtg36","slideIndex":2,"position":{"left":655.68,"top":177.6,"width":576,"height":225.6},"name":"Tech card","geometry":"roundRect","fillColor":"rgba(11,26,74,0.75)","lineColor":"#1E5BFF","lineWidth":1.33}
{"kind":"textbox","id":"sh/m5cra54z","slideIndex":2,"position":{"left":684.48,"top":196.8,"width":518.4,"height":33.6},"name":"Tech head","text":"CORE TECHNOLOGIES","geometry":"rect","style":{"fontSize":20,"typeface":"Arial","color":"#4DA3FF","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/n6ls3alk","slideIndex":2,"position":{"left":684.48,"top":240,"width":518.4,"height":153.6},"name":"Tech body","text":"Python + FastAPI REST backend\nSQLite document, term, claim, and graph stores\nReact + TypeScript + Vite frontend\nSix-way router: SQL, graph, semantic, hybrid, clarify, abstain\nNetworkX Louvain community analysis","geometry":"rect","style":{"fontSize":18.67,"typeface":"Calibri","color":"#FFFFFF","alignment":"left"}}
{"kind":"shape","id":"sh/n2l4fq98","slideIndex":2,"position":{"left":655.68,"top":422.4,"width":576,"height":220.8},"name":"Unique card","geometry":"roundRect","fillColor":"rgba(11,26,74,0.75)","lineColor":"#1E5BFF","lineWidth":1.33}
