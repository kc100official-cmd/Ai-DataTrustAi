# DataTrust AI — Environment Configuration
# Copy this file to .env to customize local settings. Never commit API keys or secrets.

# Server Configuration
DATATRUST_HOST=127.0.0.1
DATATRUST_PORT=8001
DATATRUST_DB_DIR=./backend/data

# Open-Weight LLM Configuration (<= 8B parameters required for restricted BIRD benchmark workflow)
# Supports local Ollama (e.g. http://localhost:11434/v1) or any OpenAI-compatible endpoint
DATATRUST_LLM_ENABLED=false
DATATRUST_LLM_ENDPOINT=http://localhost:11434/v1
DATATRUST_LLM_API_KEY=
DATATRUST_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
DATATRUST_LLM_PARAM_BILLIONS=8.0
DATATRUST_LLM_TIMEOUT_SECONDS=15

# Embedding Configuration (falls back to deterministic TF-IDF lexical/cosine retrieval when false)
DATATRUST_EMBEDDINGS_ENABLED=false
DATATRUST_EMBEDDING_ENDPOINT=http://localhost:11434/v1/embeddings
DATATRUST_EMBEDDING_MODEL=nomic-embed-text

# SQL Execution Guardrails
DATATRUST_SQL_TIMEOUT_SECONDS=5.0
DATATRUST_SQL_MAX_ROWS=500
DATATRUST_SQL_MAX_REPAIR_ATTEMPTS=2

# Graph Exploration Guardrails
DATATRUST_GRAPH_MAX_DEPTH=5
DATATRUST_GRAPH_MAX_NODES=150

# BIRD Benchmark Configuration
# Point DATATRUST_BIRD_DATASET_PATH to a legally obtained BIRD dev/mini-dev directory containing dev.json and dev_databases/
DATATRUST_BIRD_DATASET_PATH=
